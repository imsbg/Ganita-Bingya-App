    <!-- Mixed Templates -->
    <string name="q_mix_mul_add">તમે {1} પ્લેટમાં દરેક પર {2} મીઠાઈ મૂકી. તમારી પાસે {3} મીઠાઈઓ બાકી રહી. તો શરૂઆતમાં તમારી પાસે કુલ કેટલી મીઠાઈઓ હતી?</string>
